# Copy this file to .env and replace deployment-specific values.
ENVIRONMENT=development
API_V1_PREFIX=/api/v1

# Async PostgreSQL URL. Never commit real credentials.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/open_source_assist
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
OTP_EXPIRE_MINUTES=5

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_RELOAD=true
CORS_ALLOW_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# SMTP provider settings. Replace these values with your SMTP server details.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=rootweb.website.designers@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=rootweb.website.designers@gmail.com
SMTP_START_TLS=true
SMTP_USE_TLS=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION_NAME=open_source_repositories
QDRANT_VECTOR_SIZE=384
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
DEFAULT_POPULARITY_WEIGHT=0.3
CANDIDATE_SEARCH_LIMIT=100
DEFAULT_PAGE_LIMIT=20
